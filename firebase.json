{
  "hosting": [
    {
      "target": "production",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/upwork/callback{,/**}",
          "destination": "/upwork/callback.html"
        },
        {
          "source": "/about-us{,/**}",
          "destination": "/about-us.html"
        },
        {
          "source": "/services{,/**}",
          "destination": "/services.html"
        },
        {
          "source": "/contact-us{,/**}",
          "destination": "/contact-us.html"
        },
        {
          "source": "/test{,/**}",
          "destination": "/test.html"
        },
        {
          "source": "/blogs/ar-in-flutter{,/**}",
          "destination": "/blogs/ar-in-flutter.html"
        },
        {
          "source": "/blogs/beacon-scanning{,/**}",
          "destination": "/blogs/beacon-scanning.html"
        },
        {
          "source": "/blogs/contextless-navigation-in-flutter{,/**}",
          "destination": "/blogs/contextless-navigation-in-flutter.html"
        },
        {
          "source": "/blogs/deep-ar-part-1{,/**}",
          "destination": "/blogs/deep-ar-part-1.html"
        },
        {
          "source": "/blogs/deep-ar-part-2{,/**}",
          "destination": "/blogs/deep-ar-part-2.html"
        },
        {
          "source": "/blogs{,/**}",
          "destination": "/blogs.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/upwork/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src 'none'"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/upwork/callback{,/**}",
          "destination": "/upwork/callback.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/upwork/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src 'none'"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ]
    }
  ]
}
